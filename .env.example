# Agntia Legal - configuracion local
# Copiar a .env y completar. Nunca versionar valores reales.

PORT=3000

# Verificacion Supabase JWT (obligatoria para rutas autenticadas).
LEGAL_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
LEGAL_ISSUER=https://<project-ref>.supabase.co/auth/v1
LEGAL_AUDIENCE=authenticated

# Provisioning de membresias resuelto en servidor (nunca user_metadata).
# JSON con userId, tenantId, roles y status.
LEGAL_MEMBERSHIPS=[{"userId":"00000000-0000-0000-0000-000000000000","tenantId":"tnt_alpha","roles":["owner"],"status":"active"}]
