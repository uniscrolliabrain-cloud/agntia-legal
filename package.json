{
  "name": "@agntia/legal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agntia Legal: middleware especialista en operaciones juridicas, contratos y cumplimiento. Documentacion y scaffolding en el mismo repositorio.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run tests/e2e",
    "start": "node dist/src/server.js",
    "dev": "tsx src/server.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^22.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
